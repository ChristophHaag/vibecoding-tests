#!/bin/bash
# Run an OpenXR application with the debug GUI layer enabled.
# Generated by CMake — do not edit. Edit xr-with-debug-gui.sh.in instead.
#
# Usage:
#   xr-with-debug-gui.sh [options] <command> [args...]
#
# Options:
#   --no-gui        Set XR_DEBUG_GUI_DISABLE=1 (interceptors only, no window)
#   --fps <N>       Set XR_DEBUG_GUI_FPS=N (default: 30)
#   --help          Show this help
#
# Examples:
#   xr-with-debug-gui.sh hello_xr -G Vulkan2
#   xr-with-debug-gui.sh --fps 60 ./my_xr_app
#   xr-with-debug-gui.sh --no-gui openxr-playground

LAYER_DIR="@LAYER_BUILD_DIR@"

# ── Parse options ─────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-gui)
            export XR_DEBUG_GUI_DISABLE=1
            shift
            ;;
        --fps)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "error: --fps requires a number" >&2
                exit 1
            fi
            export XR_DEBUG_GUI_FPS="$2"
            shift 2
            ;;
        --help|-h)
            sed -n '2,/^$/{ s/^# \?//; p }' "$0"
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -eq 0 ]]; then
    echo "usage: $(basename "$0") [--no-gui] [--fps N] <command> [args...]" >&2
    exit 1
fi

# ── Verify the layer exists ───────────────────────────────────────────────────
if [[ ! -f "$LAYER_DIR/XrApiLayer_debug_gui.json" ]]; then
    echo "error: layer manifest not found at $LAYER_DIR/XrApiLayer_debug_gui.json" >&2
    echo "       Did you build the debug layer? (cmake --build debug_layer/build)" >&2
    exit 1
fi

# ── Set up environment and exec ───────────────────────────────────────────────
# Prepend our layer path so existing XR_API_LAYER_PATH entries are preserved.
if [[ -n "$XR_API_LAYER_PATH" ]]; then
    export XR_API_LAYER_PATH="$LAYER_DIR:$XR_API_LAYER_PATH"
else
    export XR_API_LAYER_PATH="$LAYER_DIR"
fi

# Enable the layer (additive — preserves any other enabled layers).
if [[ -n "$XR_ENABLE_API_LAYERS" ]]; then
    export XR_ENABLE_API_LAYERS="XR_APILAYER_DEBUG_gui:$XR_ENABLE_API_LAYERS"
else
    export XR_ENABLE_API_LAYERS="XR_APILAYER_DEBUG_gui"
fi

exec "$@"
